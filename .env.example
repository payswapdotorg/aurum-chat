# Aurum environment matrix (W069 — docs/DEPLOYMENT.md is the operator
# runbook; every value below is a placeholder, never a secret).
#
# Local development needs NOTHING set: the embedded PGlite database and
# the in-process memory backends are the legal dev/test runtimes.
# Production (and staging) set the deployment block below.

# ---------------------------------------------------------------- database
# Embedded PostgreSQL (PGlite) is the dev/test default. A real server
# (Neon Free in the dogfood profile) is selected by DATABASE_URL —
# production REQUIRES it (the embedded runtime is refused there).
AURUM_DB=embedded
DATABASE_URL=

# ------------------------------------------------------------------- redis
# Upstash Redis Free (redis://...). Selects the redis backends for
# queue/cache/lock; unset degrades to in-process memory (legal — Redis is
# never domain truth — but queue jobs do not survive restarts).
REDIS_URL=

# -------------------------------------------------------------------- email
# Resend Free transactional email (invitations, verification, alerts).
# Unset keeps the memory backend (nothing leaves the machine).
RESEND_API_KEY=
EMAIL_FROM=

# ------------------------------------------------------------ object storage
# Vercel Blob Hobby (documents, large evidence artifacts, extension
# artifacts). Unset keeps the memory backend.
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------- environments
# development | preview | staging | production. An explicit value always
# wins; otherwise VERCEL_ENV (on the platform) then NODE_ENV decide.
DEPLOYMENT_ENV=

# ------------------------------------------------- worker / execution seam
# Shared secret protecting POST/GET /api/worker (REQUIRED in production;
# development/preview may run tokenless for local exercise). CRON_SECRET
# (set on Vercel) lets the platform's cron deliveries authenticate too.
WORKER_TOKEN=
CRON_SECRET=

# ------------------------------------------------------------- guardrails
# Free-tier usage budgets — defaults in parentheses; clamped, never secret.
AURUM_WORKER_MAX_ATTEMPTS=     # retries per job before dead-letter (5)
AURUM_WORKER_BATCH_LIMIT=      # jobs per worker batch (10)
AURUM_WORKER_POLL_INTERVAL_MS= # worker poll interval (2000)
AURUM_EMAIL_DAILY_LIMIT=       # transactional emails per UTC day (100)
AURUM_BLOB_MAX_BYTES=          # max object size in bytes (8388608)
AURUM_DB_POOL_MAX=             # node-postgres pool size (5)
