# Aurum environment matrix (W069 — docs/DEPLOYMENT.md is the operator
# runbook; every value below is a placeholder, never a secret).
#
# Local development needs NOTHING set: the embedded PGlite database and
# the in-process memory backends are the legal dev/test runtimes.
# Production (and staging) set the deployment block below.

# ---------------------------------------------------------------- database
# Embedded PostgreSQL (PGlite) is the dev/test default. A real server
# (Neon Free in the dogfood profile) is selected by DATABASE_URL —
# production REQUIRES it (the embedded runtime is refused there).
AURUM_DB=embedded
DATABASE_URL=

# ------------------------------------------------------------------- redis
# Upstash Redis Free (redis://...). Selects the redis backends for
# queue/cache/lock; unset degrades to in-process memory (legal — Redis is
# never domain truth — but queue jobs do not survive restarts).
REDIS_URL=

# -------------------------------------------------------------------- email
# Resend Free transactional email (invitations, verification, alerts).
# Unset keeps the memory backend (nothing leaves the machine).
RESEND_API_KEY=
EMAIL_FROM=

# ------------------------------------------------------------ object storage
# Vercel Blob Hobby (documents, large evidence artifacts, extension
# artifacts). Unset keeps the memory backend.
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------- environments
# development | preview | staging | production. An explicit value always
# wins; otherwise VERCEL_ENV (on the platform) then NODE_ENV decide.
DEPLOYMENT_ENV=

# ------------------------------------------------- worker / execution seam
# Shared secret protecting POST/GET /api/worker (REQUIRED in production;
# development/preview may run tokenless for local exercise). CRON_SECRET
# (set on Vercel) lets the platform's cron deliveries authenticate too.
WORKER_TOKEN=
CRON_SECRET=

# ------------------------------------------------------------- guardrails
# Free-tier usage budgets — defaults in parentheses; clamped, never secret.
AURUM_WORKER_MAX_ATTEMPTS=     # retries per job before dead-letter (5)
AURUM_WORKER_BATCH_LIMIT=      # jobs per worker batch (10)
AURUM_WORKER_POLL_INTERVAL_MS= # worker poll interval (2000)
AURUM_EMAIL_DAILY_LIMIT=       # transactional emails per UTC day (100)
AURUM_BLOB_MAX_BYTES=          # max object size in bytes (8388608)
AURUM_DB_POOL_MAX=             # node-postgres pool size (5)

# ---------------------------------------------------------------- cellular
# W108 — live telecom transports (SMS/voice reach) + the carrier webhook
# edge (/api/webhooks/cellular/<provider>). UNSET or PARTIAL keeps the
# matching transport honestly UNWIRED (deliveries fail explicitly with
# provider_unavailable — retryable, never faked). Sending numbers are NOT
# env: they are per-tenant CONNECTION data (registerCellularConnection).
CELLULAR_TWILIO_ACCOUNT_SID=        # twilio Account SID ('AC...') — REST transport
CELLULAR_TWILIO_AUTH_TOKEN=         # twilio auth token — REST auth + X-Twilio-Signature verification
CELLULAR_TELNYX_API_KEY=            # telnyx API key — REST transport (Bearer)
CELLULAR_TELNYX_CALL_CONTROL_APP_ID= # telnyx Call Control Application id (voice legs; optional — SMS-only without it)
CELLULAR_TELNYX_PUBLIC_KEY=         # telnyx webhook signing PUBLIC key (base64 DER/SPKI Ed25519) — Telnyx-Signature verification
CELLULAR_WEBHOOK_PUBLIC_URL=        # optional signature-URL override behind proxy-rewritten Hosts (e.g. https://aurum.example.com)

# ------------------------------------------------------- realtime (W109)
# LiveKit Cloud (rooms + realtime transport). The env wires the REAL
# livekit transport once per process (ensureRealtimeTransportsWired,
# globalThis-anchored). UNSET or PARTIAL keeps it honestly UNWIRED
# (realtime session starts fail explicitly with provider_unavailable).
# A tenant's realtime connection registers with providerAccountId =
# LIVEKIT_ACCOUNT_ID (default: the LIVEKIT_URL host) — the account id its
# provider event envelopes carry.
LIVEKIT_URL=                        # the project's WebSocket URL ('wss://…')
LIVEKIT_API_KEY=                    # project API key (JWT iss)
LIVEKIT_API_SECRET=                 # project API secret (HS256 signing; never logged/persisted)
LIVEKIT_ACCOUNT_ID=                 # optional canonical account id (default: the URL host)
LIVEKIT_EGRESS_STREAM_URL=          # optional RTMP egress destination (unset → recording control fails honestly)
LIVEKIT_SIP_TRUNK_ID=               # optional SIP trunk id (unset → telephony dial-out fails honestly)
